# CoFlow 2.0 — never commit personal data, secrets or recordings.
# Rule of thumb: the repository holds code, docs and synthetic fixtures only.

# --- personal data and runtime state ---
data/
*.db
*.db-*
*.sqlite
*.sqlite3
backups/
logs/
*.log

# --- secrets ---
.env
.env.*
!.env.example
*.session
*.session-journal
secrets/
**/secrets.toml
token*.json
credentials*.json
client_secret*.json
*.pem
*.key

# --- recordings and media (never in git) ---
*.wav
*.mp3
*.m4a
*.ogg
*.oga
*.opus
*.flac
*.mp4
*.mov
*.webm
*.mkv

# --- models downloaded at runtime ---
models/
# ...but the kernel's model-gateway package (MDL, stage 0B) is code
!src/coflow/kernel/models/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.import_linter_cache/
.grimp_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# --- local working files (drafts, media texts, notes; never published) ---
local/

# --- editors / OS / local agent settings ---
.idea/
.vscode/
.DS_Store
Thumbs.db
.claude/settings.local.json

# --- dropped-in material that must never be published ---
Inbox/

# --- agent and tool state (P0.3) ---
# Everything under .claude/ stays local; a file committed on purpose is re-included explicitly,
# one line each, e.g. !.claude/commands/
.claude/*
.wrangler/
node_modules/

# --- archives and exported chats (P0.3) ---
*.zip
*.7z
*.tar*
*.tgz
result.json
messages*.html

# --- data roots (P0.3): the real snapshot, case scripts and reports live outside the repository ---
validation*/
coflow-data*/

# --- data-root files and exporter output, wherever a data root lands (review finding) ---
instance.lock
instance.holder.json
volume.id
**/run/core.json
**/inbox/snapshots/
reports/
v1_snapshot*.json
*.export_summary.json
