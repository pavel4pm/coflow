# LF everywhere, on every platform: ruff format checks LF, and fixtures hash the same on Windows
# and Linux.
* text=auto eol=lf

# Windows scripts keep CRLF; binaries are never converted.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.sqlite binary
*.db binary
